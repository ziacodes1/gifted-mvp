# Copy to .env and adjust for your machine.
# Local secret, >= 50 random chars (also signs JWTs). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=gifted_mvp
POSTGRES_USER=muminova
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_ACCESS_MIN=60
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI: keys stay on the backend only. Provider is swappable, no code changes needed.
#   stub      = signal-based fallback only
#   anthropic = Claude (needs AI_API_KEY)
#   gemini    = Google Gemini via google-genai (needs GEMINI_API_KEY)
#   groq      = Groq via groq SDK (needs GROQ_API_KEY) — fastest for live demos
AI_PROVIDER=stub
# Optional: on rate limit / timeout / 5xx, try this provider before the signal-based fallback.
AI_SECONDARY_PROVIDER=
AI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_REASONING_EFFORT=low
# Empty -> provider default (anthropic: claude-opus-5; gemini: newest stable Flash; groq: openai/gpt-oss-20b).
# Run `python manage.py ai_check` to see which model is used and pin it here.
AI_MODEL=
AI_EFFORT=low
AI_TIMEOUT_SECONDS=30
