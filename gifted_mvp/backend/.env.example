# Copy to .env and adjust for your machine.
# development (default) = convenient local defaults; production = fails closed
# (requires a strong secret, DEBUG false, explicit hosts — see config/security.py).
DJANGO_ENV=development
# >= 50 random chars (also signs JWTs). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind HTTPS (defaults shown; only change deliberately):
# SECURE_SSL_REDIRECT=True  SECURE_COOKIES=True  SECURE_HSTS_SECONDS=3600  CSRF_TRUSTED_ORIGINS=https://pilot.example.org

POSTGRES_DB=gifted_mvp
POSTGRES_USER=muminova
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7
PASSWORD_MIN_LENGTH=10
PARENT_CODE_TTL_HOURS=72

# Throttling (DRF rate strings). Defaults are generous for a pilot; tighten as needed.
# THROTTLE_AUTH=10/min  THROTTLE_PARENT_CONNECT=10/hour  THROTTLE_AI_GENERATION=30/hour
# THROTTLE_COMPANION=40/hour  THROTTLE_REDEEM=20/hour  THROTTLE_ANON=120/min  THROTTLE_USER=600/min

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI: keys stay on the backend only. Provider is swappable, no code changes needed.
#   stub      = signal-based fallback only
#   anthropic = Claude (needs AI_API_KEY)
#   gemini    = Google Gemini via google-genai (needs GEMINI_API_KEY)
#   groq      = Groq via groq SDK (needs GROQ_API_KEY) — fastest for live demos
AI_PROVIDER=stub
# Optional: on rate limit / timeout / 5xx, try this provider before the signal-based fallback.
AI_SECONDARY_PROVIDER=
AI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_REASONING_EFFORT=low
# Empty -> provider default (anthropic: claude-opus-5; gemini: newest stable Flash; groq: openai/gpt-oss-20b).
# Run `python manage.py ai_check` to see which model is used and pin it here.
AI_MODEL=
AI_EFFORT=low
AI_TIMEOUT_SECONDS=30

# Learner-local day for streaks/weekly points.
ACTIVITY_TIME_ZONE=Asia/Tashkent

# Private diary photos: filesystem (default) or s3 (requirements-optional.txt).
PRIVATE_STORAGE_BACKEND=filesystem
# PRIVATE_MEDIA_ROOT=/absolute/path/outside/web/root
# PRIVATE_S3_BUCKET=  PRIVATE_S3_ENDPOINT_URL=  PRIVATE_S3_REGION=  PRIVATE_S3_ACCESS_KEY_ID=  PRIVATE_S3_SECRET_ACCESS_KEY=

# Observability
LOG_FORMAT=text          # json for a log collector
LOG_LEVEL=INFO
# SENTRY_DSN=            # optional; requirements-optional.txt
# API docs at /api/v1/docs/ (default: on in development, off in production)
# API_DOCS_ENABLED=True
