# docker compose (local, plain HTTP on localhost). Copy to .env.docker.
DJANGO_ENV=production
# REQUIRED: >= 50 random chars. python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Local compose has no TLS: don't force HTTPS / secure cookies here. Remove these three for a
# real deployment behind HTTPS (the secure defaults then apply).
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False
SECURE_HSTS_SECONDS=0

LOG_FORMAT=json
API_DOCS_ENABLED=True

AI_PROVIDER=stub
GROQ_API_KEY=
AI_TIMEOUT_SECONDS=10

# PRIVATE_STORAGE_BACKEND=s3   (needs build arg WITH_OPTIONAL=1)
# PRIVATE_S3_BUCKET=
# PRIVATE_S3_ENDPOINT_URL=
# PRIVATE_S3_REGION=
# PRIVATE_S3_ACCESS_KEY_ID=
# PRIVATE_S3_SECRET_ACCESS_KEY=
# SENTRY_DSN=
